{
  "name": "relay-v3",
  "version": "0.0.0",
  "private": true,
  "description": "relay-v3: 계약과 증거로 AI 에이전트의 일을 맡기는 하네스 (docs/philosophy.md)",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "relay": "src/cli/main.ts"
  },
  "scripts": {
    "relay": "node src/cli/main.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "limits": "node scripts/limits.mjs",
    "test": "vitest run --project unit --project adapters --project flow",
    "test:unit": "vitest run --project unit",
    "test:adapters": "vitest run --project adapters",
    "test:flow": "vitest run --project flow",
    "test:replay": "vitest run --project unit test/unit/gate-replay.test.ts --silent=false",
    "replay:review": "node scripts/review-replay.ts",
    "test:smoke": "electron-vite build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run limits && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.5",
    "electron-vite": "5.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "node-pty": "1.1.0",
    "picomatch": "4.0.7"
  }
}
